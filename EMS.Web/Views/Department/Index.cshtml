@model EMS.Entities.Common.PaginatedList<EMS.Entities.Entities.Department>

@{
    ViewData["Title"] = "Departments";

    string GetSortUrl(string column)
    {
        string sortOrder = "asc";

        if (ViewBag.SortColumn == column &&
            ViewBag.SortOrder == "asc")
        {
            sortOrder = "desc";
        }

        return Url.Action("Index", "Department", new
        {
            search = ViewBag.Search,
            sortColumn = column,
            sortOrder = sortOrder,
            pageNumber = 1
        })!;
    }
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Departments</h2>
            <p class="text-muted mb-0">
                Manage your organization's departments.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Department
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  asp-controller="Department"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-8">

                        <label class="form-label">
                            Search Department
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by department name..." />

                    </div>

                    <div class="col-md-4">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-search"></i>
                                Search
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Reset
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Department Table -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Department List
                </h5>

                <span class="text-muted">
                    Total Records: @Model.TotalRecords
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    <a href="@GetSortUrl("departmentname")"
                                       class="text-decoration-none text-dark">

                                        Department Name

                                        @if (ViewBag.SortColumn == "departmentname")
                                        {
                                            if (ViewBag.SortOrder == "asc")
                                            {
                                                <i class="bi bi-arrow-up"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-down"></i>
                                            }
                                        }

                                    </a>
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int serialNumber =
                                ((Model.CurrentPage - 1)
                                * Model.PageSize) + 1;
                            }

                            @foreach (var department in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @serialNumber
                                    </td>

                                    <td>
                                        <strong>
                                            @department.DepartmentName
                                        </strong>
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">

                                            <a asp-action="Edit"
                                               asp-route-id="@department.DepartmentId"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-pencil"></i>
                                                Edit

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@department.DepartmentId"
                                               class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-building fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No Departments Found
                    </h5>

                    <p class="text-muted">
                        No department records match your search.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        Add Department

                    </a>

                </div>
            }

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between align-items-center">

                    <div class="text-muted">

                        Showing
                        @(((Model.CurrentPage - 1) * Model.PageSize) + 1)
                        -
                        @(Math.Min(
                                            Model.CurrentPage * Model.PageSize,
                                            Model.TotalRecords))

                        of @Model.TotalRecords

                    </div>


                    <nav>

                        <ul class="pagination mb-0">

                            <!-- Previous -->
                            <li class="page-item
                                    @(Model.CurrentPage == 1
                                                                    ? "disabled"
                                                                    : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortColumn="@ViewBag.SortColumn"
                               asp-route-sortOrder="@ViewBag.SortOrder"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)">

                                    Previous

                                </a>

                            </li>


                            <!-- Page Numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item
                                            @(i == Model.CurrentPage
                                                                            ? "active"
                                                                            : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortColumn="@ViewBag.SortColumn"
                               asp-route-sortOrder="@ViewBag.SortOrder"
                               asp-route-pageNumber="@i">

                                        @i

                                    </a>

                                </li>
                                                }


                        <!-- Next -->
                        <li class="page-item
                                @(Model.CurrentPage == Model.TotalPages
                                                                ? "disabled"
                                                                : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortColumn="@ViewBag.SortColumn"
                               asp-route-sortOrder="@ViewBag.SortOrder"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)">

                                    Next

                                </a>

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>
                }

    </div>

</div>