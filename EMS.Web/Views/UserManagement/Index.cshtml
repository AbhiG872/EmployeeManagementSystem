@model List<EMS.Entities.Entities.Employee>

<div class="container mt-4">

    <h3 class="mb-3">User Management</h3>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>Employee Name</th>
                        <th>Login Email</th>
                        <th>Login Access</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var employee in Model)
                    {
                        <tr>

                            <td>
                                @employee.FirstName @employee.LastName
                            </td>

                            <td>
                                @(employee.ApplicationUser?.Email ?? "Not Created")
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(employee.ApplicationUserId))
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Not Created
                                    </span>
                                }
                            </td>

                            <td>

                                @if (string.IsNullOrEmpty(employee.ApplicationUserId))
                                {
                                    <a asp-action="CreateLoginAccess"
                                       asp-route-id="@employee.EmployeeId"
                                       class="btn btn-sm btn-primary">
                                        Create Login
                                    </a>
                                }
                                else
                                {
                                    <span class="text-success">
                                        Login Created
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>