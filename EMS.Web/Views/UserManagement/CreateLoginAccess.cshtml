@model EMS.Web.Models.CreateEmployeeLoginViewModel

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-5 col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h3 class="text-center mb-4">
                        Create Login Access
                    </h3>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Employee
                        </label>

                        <input value="@Model.EmployeeName"
                               class="form-control"
                               readonly />
                    </div>

                    <form asp-action="CreateLoginAccess"
                          method="post">

                        <input asp-for="EmployeeId"
                               type="hidden" />

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Login Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter employee email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Create Login Access
                        </button>

                    </form>

                    <div class="text-center mt-3">

                        <a asp-action="Index">
                            Back to Users
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}