@model EMS.Entities.Entities.Employee

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">My Profile</h2>
        <p class="text-muted mb-0">
            View your employee information
        </p>
    </div>


    <!-- Profile Card -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <!-- Profile Header -->
        <div class="bg-primary text-white p-4">

            <div class="row align-items-center">

                <!-- Profile Image -->
                <div class="col-md-3 text-center">

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath"
                             alt="Employee Image"
                             class="rounded-circle border border-4 border-white shadow"
                             style="width:150px;
                                        height:150px;
                                        object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-white text-primary
                                        d-flex align-items-center justify-content-center
                                        mx-auto shadow"
                             style="width:150px;
                                        height:150px;
                                        font-size:50px;
                                        font-weight:bold;">

                            @Model.FirstName.Substring(0, 1).ToUpper()

                        </div>
                    }

                </div>


                <!-- Employee Basic Information -->
                <div class="col-md-9 text-center text-md-start mt-3 mt-md-0">

                    <h2 class="fw-bold mb-1">
                        @Model.FirstName @Model.LastName
                    </h2>

                    <p class="mb-2 opacity-75">
                        @Model.Designation?.DesignationName
                    </p>

                    <span class="badge bg-light text-primary px-3 py-2">
                        @Model.EmployeeCode
                    </span>

                </div>

            </div>

        </div>


        <!-- Employee Details -->
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                <i class="bi bi-person-vcard me-2"></i>
                Employee Information
            </h5>


            <div class="row g-4">

                <!-- First Name -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            First Name
                        </small>

                        <div class="fw-semibold">
                            @Model.FirstName
                        </div>

                    </div>

                </div>


                <!-- Last Name -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Last Name
                        </small>

                        <div class="fw-semibold">
                            @Model.LastName
                        </div>

                    </div>

                </div>


                <!-- Email -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Email Address
                        </small>

                        <div class="fw-semibold">
                            @Model.Email
                        </div>

                    </div>

                </div>


                <!-- Mobile -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Mobile Number
                        </small>

                        <div class="fw-semibold">
                            @Model.Phone
                        </div>

                    </div>

                </div>


                <!-- Department -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Department
                        </small>

                        <div class="fw-semibold">
                            @(Model.Department?.DepartmentName ?? "N/A")
                        </div>

                    </div>

                </div>


                <!-- Designation -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Designation
                        </small>

                        <div class="fw-semibold">
                            @(Model.Designation?.DesignationName ?? "N/A")
                        </div>

                    </div>

                </div>


                <!-- Salary -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Salary
                        </small>

                        <div class="fw-semibold">
                            ₹ @Model.Salary
                        </div>

                    </div>

                </div>


                <!-- Date Of Joining -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <small class="text-muted">
                            Date Of Joining
                        </small>

                        <div class="fw-semibold">
                            @Model.DateOfJoining.ToString("dd-MM-yyyy")
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Footer -->
        <div class="card-footer bg-light border-0 p-3">

            <div class="text-muted small">
                <i class="bi bi-shield-check me-1"></i>
                Employee profile information
            </div>

        </div>

    </div>

</div>


<style>

    .profile-info {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 14px 16px;
        min-height: 75px;
        transition: all 0.2s ease;
    }

        .profile-info:hover {
            border-color: #0d6efd;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

</style>