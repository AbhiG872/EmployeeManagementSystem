@model EMS.Entities.Entities.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">

    <h2>Employee Details</h2>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">Employee Code</dt>
        <dd class="col-sm-9">@Model.EmployeeCode</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">
            @Model.FirstName @Model.LastName
        </dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>

        <dt class="col-sm-3">Joining Date</dt>
        <dd class="col-sm-9">
            @Model.DateOfJoining.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department</dd>

        <dt class="col-sm-3">Designation</dt>
        <dd class="col-sm-9">@Model.Designation</dd>

        <dt class="col-sm-3">Salary</dt>
        <dd class="col-sm-9">@Model.Salary</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

    </dl>

    <a asp-action="Edit"
       asp-route-id="@Model.EmployeeId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>