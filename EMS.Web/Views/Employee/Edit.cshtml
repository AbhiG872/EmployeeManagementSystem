@model EMS.Entities.Entities.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Edit Employee</h2>

            <p class="text-muted mb-0">
                Update employee information
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Employees
        </a>

    </div>


    <!-- Edit Employee Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">
                Employee Information
            </h5>

        </div>


        <div class="card-body p-4">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <!-- Employee ID -->
                <input type="hidden"
                       asp-for="EmployeeId" />


                <!-- Validation -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row">


                    <!-- Employee Code -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeCode"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="EmployeeCode"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="EmployeeCode"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- First Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="FirstName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="Enter first name" />

                        <span asp-validation-for="FirstName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Last Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="LastName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Enter last name" />

                        <span asp-validation-for="LastName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Email -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Phone -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Date of Joining -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="DateOfJoining"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="DateOfJoining"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DateOfJoining"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Department -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Department"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Department"
                               class="form-control"
                               placeholder="e.g. IT" />

                        <span asp-validation-for="Department"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Designation -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Designation"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Designation"
                               class="form-control"
                               placeholder="e.g. Software Developer" />

                        <span asp-validation-for="Designation"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Salary -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Salary"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="Salary"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="45000" />

                        </div>

                        <span asp-validation-for="Salary"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Status"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Employee Image -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Employee Image
                        </label>

                        <div class="mb-2">

                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <img src="@Model.ImagePath"
                                     alt="@Model.FirstName"
                                     class="current-employee-image" />
                            }
                            else
                            {
                                <div class="default-avatar">
                                    @Model.FirstName?.Substring(0, 1).ToUpper()
                                </div>
                            }

                        </div>


                        <input type="file"
                               name="imageFile"
                               class="form-control"
                               accept="image/*" />

                        <small class="text-muted">
                            Select a new image if you want to replace the current image.
                        </small>

                    </div>


                </div>


                <!-- Buttons -->
                <div class="border-top pt-3 mt-3">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        Update Employee

                    </button>


                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4 ms-2">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .card {
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
    }

    .form-label {
        font-size: 14px;
    }

    .form-control,
    .form-select {
        min-height: 42px;
        border-radius: 6px;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
        }

    .input-group-text {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .current-employee-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #e9ecef;
    }

    .default-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        font-weight: 600;
    }

</style>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}