@model EMS.Entities.Common.PaginatedList<EMS.Entities.Entities.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid mt-4">

    <!-- =========================
         Page Header
    ========================== -->
 
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Employee Management
            </h2>

            <p class="text-muted mb-0">
                Manage employees and their information
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-1"></i>
            Add Employee
        </a>

    </div>


    <!-- =========================
         Search & Filter
    ========================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex align-items-center">

                <i class="bi bi-funnel me-2 text-primary"></i>

                <h5 class="mb-0 fw-semibold">
                    Search & Filter
                </h5>

            </div>

        </div>


        <div class="card-body">

            <form id="employeeSearchForm">

                <div class="row g-3 align-items-end">

                    <!-- Global Search -->

                    <div class="col-lg-5 col-md-6">

                        <label class="form-label fw-semibold">
                            Search Employee
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   id="searchInput"
                                   class="form-control"
                                   placeholder="Name, code, email, department..." />

                        </div>

                    </div>


                    <!-- Department -->

                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Department
                        </label>

                        @* <select name="department"
                                id="departmentFilter"
                                class="form-select">

                            <option value="">
                                All Departments
                            </option>

                            <option value="IT">
                                IT
                            </option>

                            <option value="HR">
                                HR
                            </option>

                            <option value="Finance">
                                Finance
                            </option>

                            <option value="Sales">
                                Sales
                            </option>

                        </select> *@

                    </div>


                    <!-- Status -->

                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                id="statusFilter"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>


                    <!-- Buttons -->

                    <div class="col-lg-2 col-md-6">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">

                                <i class="bi bi-search me-1"></i>
                                Search

                            </button>


                            <button type="button"
                                    id="clearFilters"
                                    class="btn btn-outline-secondary"
                                    title="Clear Filters">

                                <i class="bi bi-arrow-clockwise"></i>

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================
         Employee List
    ========================== -->

    <div class="card shadow-sm border-0">

        <!-- Employee List Header -->

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center">

                    <i class="bi bi-people me-2 text-primary"></i>

                    <h5 class="mb-0 fw-semibold">
                        Employee List
                    </h5>

                </div>


                <!-- Dynamic Employee Count -->

                <span id="employeeCount"
                      class="badge bg-primary px-3 py-2">

                    0 Employees

                </span>

            </div>

        </div>


        <!-- Employee Table -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table id="employeeTable"
                       class="table table-hover align-middle mb-0">

                    <!-- Table Header -->

                    <thead class="table-light">

                        <tr>

                            <th class="px-3">

                                <button type="button"
                                        class="sort-btn"
                                        data-column="employeeCode">

                                    Employee Code
                                    <span>↕</span>

                                </button>

                            </th>


                            <th>

                                <button type="button"
                                        class="sort-btn"
                                        data-column="name">

                                    Name
                                    <span>↕</span>

                                </button>

                            </th>


                            <th>
                                Email
                            </th>


                            <th>
                                Phone
                            </th>


                            <th>

                                <button type="button"
                                        class="sort-btn"
                                        data-column="department">

                                    Department
                                    <span>↕</span>

                                </button>

                            </th>


                            <th>

                                <button type="button"
                                        class="sort-btn"
                                        data-column="designation">

                                    Designation
                                    <span>↕</span>

                                </button>

                            </th>
                            <th>
                                Reporting Manager
                            </th>

                            <th>

                                <button type="button"
                                        class="sort-btn"
                                        data-column="salary">

                                    Salary
                                    <span>↕</span>

                                </button>

                            </th>


                            <th>

                                <button type="button"
                                        class="sort-btn"
                                        data-column="status">

                                    Status
                                    <span>↕</span>

                                </button>

                            </th>


                            <th>
                                Image
                            </th>


                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <!-- Table Body -->

                    <tbody id="employeeTableBody">

                        <!--
                            Employee records
                            will be loaded by employee.js
                        -->

                    </tbody>

                </table>


                <!-- Loading -->

                <div id="loadingIndicator"
                     class="text-center py-4 d-none">

                    <div class="spinner-border text-primary"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                    <p class="text-muted mt-2 mb-0">
                        Loading employees...
                    </p>

                </div>


                <!-- No Data -->

                <div id="noEmployeeMessage"
                     class="text-center py-5 d-none">

                    <div class="text-muted">

                        <i class="bi bi-search fs-2 d-block mb-2"></i>

                        <h6 class="fw-semibold">
                            No employees found
                        </h6>

                        <p class="mb-0">
                            Try changing your search or filter criteria.
                        </p>

                    </div>

                </div>


                <!-- Pagination -->

                <div id="paginationContainer"
                     class="mt-4 mb-4">
                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/employee.js"></script>

}