@model EMS.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow">
                <div class="card-body p-3">

                    <h3 class="text-center mb-3">Create Account</h3>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-2">
                        </div>

                        <div class="row">

                            <!-- First Name -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="FirstName"
                                       class="form-label mb-1">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter first name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="LastName"
                                       class="form-label mb-1">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="Email"
                                       class="form-label mb-1">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter email address" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Mobile Number -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="MobileNumber"
                                       class="form-label mb-1">
                                    Mobile Number
                                </label>

                                <input asp-for="MobileNumber"
                                       class="form-control"
                                       placeholder="Enter mobile number" />

                                <span asp-validation-for="MobileNumber"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="Password"
                                       class="form-label mb-1">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="Enter password" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="ConfirmPassword"
                                       class="form-label mb-1">
                                    Confirm Password
                                </label>

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       placeholder="Confirm password" />

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <!-- Register Button -->
                        <div class="d-grid mt-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Register
                            </button>
                        </div>

                    </form>

                    <!-- Login Link -->
                    <div class="text-center mt-2">
                        <small>
                            Already have an account?

                            <a asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </small>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}