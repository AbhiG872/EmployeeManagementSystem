@model EMS.Entities.Entities.Designation

@{
    ViewData["Title"] = "Delete Designation";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="mb-1">
            Delete Designation
        </h2>

        <p class="text-muted mb-0">
            Confirm before deleting this designation.
        </p>

    </div>


    <!-- Delete Confirmation Card -->
    <div class="card shadow-sm border-danger">

        <div class="card-header bg-white">

            <h5 class="mb-0 text-danger">

                <i class="bi bi-exclamation-triangle"></i>

                Delete Confirmation

            </h5>

        </div>


        <div class="card-body">

            <!-- Warning -->
            <div class="alert alert-warning">

                <strong>Warning!</strong>

                Are you sure you want to delete this designation?

            </div>


            <!-- Designation Information -->
            <dl class="row mb-4">

                <!-- Designation ID -->
                <dt class="col-sm-3">
                    Designation ID
                </dt>

                <dd class="col-sm-9">
                    @Model.DesignationId
                </dd>


                <!-- Designation Name -->
                <dt class="col-sm-3">
                    Designation Name
                </dt>

                <dd class="col-sm-9">

                    <strong>
                        @Model.DesignationName
                    </strong>

                </dd>


                <!-- Department -->
                <dt class="col-sm-3">
                    Department
                </dt>

                <dd class="col-sm-9">

                    @Model.Department?.DepartmentName

                </dd>

            </dl>


            <!-- Delete Form -->
            <form asp-action="Delete"
                  asp-controller="Designation"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       asp-for="DesignationId" />


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Yes, Delete

                    </button>


                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>